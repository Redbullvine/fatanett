# Copy to .env and fill in values before running locally

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_PREMIUM_MODEL=claude-opus-4-5
ANTHROPIC_VERIFIER_MODEL=claude-haiku-3-5

WOLFRAM_APP_ID=XXXXXX-XXXXXXXXXX
ENABLE_WOLFRAM_VERIFICATION=true
ENABLE_PREMIUM_ESCALATION=true

MAX_PROBLEM_CHARS=6000
MAX_PREMIUM_SOLVES_PER_DAY=25
CACHE_TTL_HOURS=24

# Comma-separated origins allowed to call this API
ALLOWED_ORIGINS=https://fatanett.com,http://localhost:3000,http://localhost:8888
